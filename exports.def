LIBRARY ttio

EXPORTS
    ArrowheadUSBGetDeviceVersion=ttioGetDeviceVersion @1
    ArrowheadUSBIOClose=ttioClose @2
    ArrowheadUSBIOGetStatus=ttioGetStatus @3
    ArrowheadUSBIOOpen=ttioOpen @4
    ArrowheadUSBIOUpdate=ttioUpdate @5
    VisionUSBGetDeviceVersion=ttioGetDeviceVersion
    VisionUSBIOClose=ttioClose
    VisionUSBIOGetStatus=ttioGetStatus
    VisionUSBIOOpen=ttioOpen
    VisionUSBIOUpdate=ttioUpdate
    NESiCAReaderCancelRead @6
    NESiCAReaderGetID @7
    NESiCAReaderGetIDAndAmic
    NESiCAReaderGetResult @8
    NESiCAReaderGetStatus @9
    NESiCAReaderGetXioStatus
    NESiCAReaderOpen=ttioOpen
    NESiCAReaderIsError
    NESiCAReaderRead @10
    NESiCAReaderUpdate
